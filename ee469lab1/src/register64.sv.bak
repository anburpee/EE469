// 64 bit register with reset and write enable
module register64(data_out, data_in, wren, reset, clk);

    localparam int REG_SIZE = 64;
    
    output logic [REG_SIZE-1:0] data_out;
    input logic [REG_SIZE-1:0] data_in;
    input logic wren, reset, clk;

    genvar i;
    generate
        for (i=0; i<REG_SIZE; i++) begin: dff_block
            D_FF_enabled en_dff (.q_enabled(data_out[i]), .d(data_in[i]), .reset(reset), .clk(clk), .en(wren));
        end
    endgenerate

endmodule // register64


module register64_tb();
parameter REG_SIZE = 64;

logic [REG_SIZE-1:0] data_out;
logic [REG_SIZE-1:0] data_in;
logic wren, reset, clk;

// simulation clock
parameter CLOCK_PERIOD = 100;
initial begin
    clk <= 0;
    forever #(CLOCK_PERIOD) clk <= ~clk;
end

// stimulus
initial begin
    @(posedge clk);
    reset <= 1'b1; @(posedge clk);
    reset <= 1'b0; @(posedge clk);

    data_in <= 64'd63;  wren <= 1'b0; repeat(2) @(posedge clk);
                        wren <= 1'b1; repeat(2) @(posedge clk);
    
    data_in <= 64'd0;  wren <= 1'b0; repeat(2) @(posedge clk);
                       wren <= 1'b1; repeat(2) @(posedge clk);
    $stop;
end

endmodule